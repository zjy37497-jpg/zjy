.mine-page {
  background:
    linear-gradient(180deg, rgba(255, 225, 212, 0.72) 0, rgba(255, 248, 244, 0.92) 520rpx, #fff 850rpx);
}

.mine-scroll {
  height: 100vh;
}

.mine-wrap {
  padding: 12rpx 26rpx 0;
}

.profile-hero {
  position: relative;
  min-height: 310rpx;
  padding: 46rpx 28rpx 30rpx;
  overflow: hidden;
}

.profile-copy {
  position: relative;
  z-index: 2;
}

.profile-kicker {
  color: #be7569;
  font-size: 21rpx;
  font-weight: 650;
}

.profile-title {
  margin-top: 14rpx;
  color: #2c2220;
  font-size: 48rpx;
  font-weight: 800;
}

.profile-desc {
  margin-top: 12rpx;
  color: #8b7d79;
  font-size: 24rpx;
}

.profile-mascot {
  position: absolute;
  right: 18rpx;
  bottom: 8rpx;
  width: 230rpx;
  height: 186rpx;
  border-radius: 100rpx 100rpx 24rpx 100rpx;
  background: linear-gradient(145deg, #ffb7a1, #ff9086);
  box-shadow: 0 22rpx 40rpx rgba(214, 113, 102, 0.16);
}

.mini-face {
  position: absolute;
  right: 10rpx;
  bottom: -10rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  width: 176rpx;
  height: 176rpx;
  border-radius: 50%;
  background: linear-gradient(145deg, #fff, #ffedf2);
}

.mini-eye {
  width: 16rpx;
  height: 48rpx;
  margin: 0 16rpx;
  border-radius: 12rpx;
  background: #4a302f;
  transform: rotate(-28deg);
}

.mini-eye:last-child {
  transform: rotate(28deg);
}

.profile-spark {
  position: absolute;
  top: -28rpx;
  left: 18rpx;
  color: #fff2ee;
  font-size: 80rpx;
  text-shadow: 0 12rpx 20rpx rgba(219, 126, 112, 0.15);
  transform: rotate(8deg);
}

.stats-row {
  display: flex;
  align-items: center;
  min-height: 132rpx;
  padding: 16rpx 10rpx;
  border: 1rpx solid rgba(242, 232, 228, 0.9);
  border-radius: 25rpx;
  background: rgba(255, 255, 255, 0.92);
  box-shadow: 0 14rpx 40rpx rgba(142, 101, 89, 0.06);
}

.stat-item {
  display: flex;
  align-items: center;
  flex: 1;
  flex-direction: column;
  justify-content: center;
  min-width: 0;
}

.stat-value {
  color: #3d302e;
  font-size: 28rpx;
  font-weight: 700;
}

.stat-label {
  margin-top: 6rpx;
  color: #ac9f9c;
  font-size: 19rpx;
}

.stat-divider {
  width: 1rpx;
  height: 44rpx;
  background: #f0e7e4;
}

.mine-card {
  margin-top: 22rpx;
  padding: 26rpx;
  border: 1rpx solid rgba(242, 232, 228, 0.9);
  border-radius: 25rpx;
  background: #fff;
  box-shadow: 0 12rpx 36rpx rgba(139, 101, 88, 0.05);
}

.card-head {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
}

.card-title {
  color: #3a2e2c;
  font-size: 27rpx;
  font-weight: 650;
}

.card-subtitle {
  display: -webkit-box;
  overflow: hidden;
  margin-top: 6rpx;
  color: #a99c99;
  font-size: 21rpx;
  line-height: 1.55;
  -webkit-box-orient: vertical;
  -webkit-line-clamp: 2;
}

.card-mark {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 56rpx;
  height: 56rpx;
  flex: none;
  margin-left: 18rpx;
  border-radius: 16rpx;
  font-size: 27rpx;
}

.card-mark-coral {
  color: #ff7268;
  background: #fff0ee;
}

.card-mark-orange {
  background: #fff3e7;
}

.goal-picker {
  display: flex;
  align-items: center;
  justify-content: space-between;
  height: 86rpx;
  margin-top: 22rpx;
  padding: 0 22rpx;
  border-radius: 17rpx;
  background: #fff8f6;
  color: #e07063;
  font-size: 25rpx;
  font-weight: 600;
}

.goal-arrow {
  color: #c9bab6;
  font-size: 36rpx;
  font-weight: 300;
}

.plan-card {
  background: linear-gradient(150deg, #fff, #fff9f5);
}

.plan-heading-wrap {
  min-width: 0;
  padding-right: 10rpx;
}

.plan-action-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-top: 22rpx;
  padding-top: 18rpx;
  border-top: 1rpx solid #f3ece9;
  color: #ee7668;
  font-size: 22rpx;
}

.plan-arrow {
  font-size: 30rpx;
}

.version-pill {
  display: flex;
  align-items: center;
  justify-content: center;
  height: 42rpx;
  padding: 0 14rpx;
  border-radius: var(--radius-pill);
  background: #f7f2f0;
  color: #a49592;
  font-size: 18rpx;
}

.info-line {
  display: flex;
  align-items: center;
  justify-content: space-between;
  min-height: 76rpx;
  border-bottom: 1rpx solid #f5efec;
  color: #a29592;
  font-size: 22rpx;
}

.info-line:last-child {
  border-bottom: 0;
}

.info-label {
  color: #5d504d;
}

.health-note {
  padding: 24rpx 18rpx 8rpx;
  color: #b4a7a3;
  font-size: 20rpx;
  line-height: 1.7;
  text-align: center;
}

.clear-button {
  height: 82rpx;
  margin-top: 18rpx;
  border: 1rpx solid #efe4e0;
  border-radius: 20rpx;
  background: #fff;
  color: #b78980;
  font-size: 23rpx;
}

.bottom-space {
  height: calc(54rpx + env(safe-area-inset-bottom));
}
