<view class="app-page index-page">
  <image
    wx:if="{{!messages.length}}"
    class="page-background"
    src="/images/figma/hero-background.png"
    mode="scaleToFill"
  />
  <image
    wx:else
    class="page-background"
    src="/images/figma/chat-background.jpg"
    mode="scaleToFill"
  />
  <view wx:if="{{!messages.length}}" class="hero-flow">
    <view class="flow-blob flow-pink"></view>
    <view class="flow-blob flow-peach"></view>
    <view class="flow-blob flow-lilac"></view>
    <view class="flow-blob flow-mint"></view>
    <view class="flow-blob flow-rose"></view>
  </view>
  <view class="custom-nav">
    <view style="padding-top: {{statusBarHeight}}px;">
      <view class="nav-art-shell" style="height: {{navBarHeight}}px;">
        <image class="nav-art-image" src="/images/figma/nav.png" mode="scaleToFill" />
        <button class="nav-hit nav-hit-back" bindtap="handleBack" aria-label="返回"></button>
        <button class="nav-hit nav-hit-add" bindtap="openAttach" aria-label="添加记录"></button>
        <button class="nav-hit nav-hit-more" bindtap="openMore" aria-label="更多"></button>
      </view>
    </view>
  </view>

  <scroll-view
    id="chat-scroll"
    class="index-scroll"
    style="padding-top: {{navTotalHeight}}px;"
    scroll-y
    scroll-with-animation
    scroll-top="{{scrollTop}}"
    bindscroll="onChatScroll"
  >
    <view wx:if="{{!messages.length}}">
      <view class="home-hero">
        <view class="mascot-stage">
          <image class="mascot-body" src="/images/figma/mascot-body.png" mode="scaleToFill" />
          <image class="mascot-star-layer" src="/images/figma/mascot-star-full.png" mode="scaleToFill" />
          <view class="mascot-eyes-layer">
            <image class="mascot-eye-left" src="/images/figma/mascot-eye-left.png" mode="scaleToFill" />
            <image class="mascot-eye-right" src="/images/figma/mascot-eye-right.png" mode="scaleToFill" />
            <image class="mascot-eye-open" src="/images/figma/mascot-eye-left.png" mode="scaleToFill" />
          </view>
          <image class="mascot-spark" src="/images/figma/mascot-wink-spark.png" mode="scaleToFill" />
          <view class="mascot-dot mascot-dot-a"></view>
          <view class="mascot-dot mascot-dot-b"></view>
        </view>
        <view class="hero-copy">
          <view wx:if="{{heroEntrance}}" class="hero-slogan-animated" aria-label="一起进步，成为更好的自己">
            <view class="hero-glyph glyph-yi" style="left:0.00rpx;top:0.00rpx;width:47.14rpx;height:47.92rpx;animation-delay:0.000s;">
              <image class="hero-glyph-image" src="/images/figma/hero-slogan-crisp.svg" mode="scaleToFill" style="left:-0.00rpx;top:-0.00rpx;" />
            </view>
            <view class="hero-glyph glyph-qi" style="left:47.14rpx;top:0.00rpx;width:47.14rpx;height:47.92rpx;animation-delay:0.095s;">
              <image class="hero-glyph-image" src="/images/figma/hero-slogan-crisp.svg" mode="scaleToFill" style="left:-47.14rpx;top:-0.00rpx;" />
            </view>
            <view class="hero-glyph glyph-jin" style="left:94.29rpx;top:0.00rpx;width:47.70rpx;height:47.92rpx;animation-delay:0.190s;">
              <image class="hero-glyph-image" src="/images/figma/hero-slogan-crisp.svg" mode="scaleToFill" style="left:-94.29rpx;top:-0.00rpx;" />
            </view>
            <view class="hero-glyph glyph-bu" style="left:141.99rpx;top:0.00rpx;width:46.58rpx;height:47.92rpx;animation-delay:0.285s;">
              <image class="hero-glyph-image" src="/images/figma/hero-slogan-crisp.svg" mode="scaleToFill" style="left:-141.99rpx;top:-0.00rpx;" />
            </view>
            <view class="hero-glyph glyph-cheng" style="left:0.00rpx;top:64.64rpx;width:47.70rpx;height:47.36rpx;animation-delay:0.380s;">
              <image class="hero-glyph-image" src="/images/figma/hero-slogan-crisp.svg" mode="scaleToFill" style="left:-0.00rpx;top:-64.64rpx;" />
            </view>
            <view class="hero-glyph glyph-wei" style="left:47.70rpx;top:64.64rpx;width:46.58rpx;height:47.36rpx;animation-delay:0.475s;">
              <image class="hero-glyph-image" src="/images/figma/hero-slogan-crisp.svg" mode="scaleToFill" style="left:-47.70rpx;top:-64.64rpx;" />
            </view>
            <view class="hero-glyph glyph-geng" style="left:94.29rpx;top:64.64rpx;width:47.14rpx;height:47.36rpx;animation-delay:0.570s;">
              <image class="hero-glyph-image" src="/images/figma/hero-slogan-crisp.svg" mode="scaleToFill" style="left:-94.29rpx;top:-64.64rpx;" />
            </view>
            <view class="hero-glyph glyph-hao" style="left:141.43rpx;top:64.64rpx;width:48.83rpx;height:47.36rpx;animation-delay:0.665s;">
              <image class="hero-glyph-image" src="/images/figma/hero-slogan-crisp.svg" mode="scaleToFill" style="left:-141.43rpx;top:-64.64rpx;" />
            </view>
            <view class="hero-glyph glyph-de" style="left:190.26rpx;top:64.64rpx;width:49.39rpx;height:47.36rpx;animation-delay:0.760s;">
              <image class="hero-glyph-image" src="/images/figma/hero-slogan-crisp.svg" mode="scaleToFill" style="left:-190.26rpx;top:-64.64rpx;" />
            </view>
            <view class="hero-glyph glyph-zi" style="left:239.64rpx;top:64.64rpx;width:42.65rpx;height:47.36rpx;animation-delay:0.855s;">
              <image class="hero-glyph-image" src="/images/figma/hero-slogan-crisp.svg" mode="scaleToFill" style="left:-239.64rpx;top:-64.64rpx;" />
            </view>
            <view class="hero-glyph glyph-ji" style="left:282.30rpx;top:64.64rpx;width:47.70rpx;height:47.36rpx;animation-delay:0.950s;">
              <image class="hero-glyph-image" src="/images/figma/hero-slogan-crisp.svg" mode="scaleToFill" style="left:-282.30rpx;top:-64.64rpx;" />
            </view>
          </view>
        </view>
      </view>

      <view class="home-section function-section">
        <view class="home-section-title">常用功能</view>
        <view class="function-grid">
          <view id="ripple-card-1" data-rippleid="card-1" bindtouchstart="startTouchRipple" class="function-item tap-feedback" hover-class="tap-feedback-active" hover-start-time="0" hover-stay-time="180" data-action="plan" bindtap="openQuick">
          <view wx:if="{{ripple.id === 'card-1'}}" class="touch-ripple" style="left:{{ripple.x}}px;top:{{ripple.y}}px;" />
            <image class="function-icon" src="/images/figma/icon-plan.png" mode="aspectFit" />
            <text>训练计划</text>
          </view>
          <view id="ripple-card-2" data-rippleid="card-2" bindtouchstart="startTouchRipple" class="function-item tap-feedback" hover-class="tap-feedback-active" hover-start-time="0" hover-stay-time="180" data-action="exercise" bindtap="openQuick">
          <view wx:if="{{ripple.id === 'card-2'}}" class="touch-ripple" style="left:{{ripple.x}}px;top:{{ripple.y}}px;" />
            <image class="function-icon" src="/images/figma/icon-exercise.png" mode="aspectFit" />
            <text>运动记录</text>
          </view>
          <view id="ripple-card-3" data-rippleid="card-3" bindtouchstart="startTouchRipple" class="function-item tap-feedback" hover-class="tap-feedback-active" hover-start-time="0" hover-stay-time="180" data-action="diet" bindtap="openQuick">
          <view wx:if="{{ripple.id === 'card-3'}}" class="touch-ripple" style="left:{{ripple.x}}px;top:{{ripple.y}}px;" />
            <image class="function-icon" src="/images/figma/icon-diet.png" mode="aspectFit" />
            <text>饮食记录</text>
          </view>
          <view id="ripple-card-4" data-rippleid="card-4" bindtouchstart="startTouchRipple" class="function-item tap-feedback" hover-class="tap-feedback-active" hover-start-time="0" hover-stay-time="180" data-action="weight" bindtap="openQuick">
          <view wx:if="{{ripple.id === 'card-4'}}" class="touch-ripple" style="left:{{ripple.x}}px;top:{{ripple.y}}px;" />
            <image class="function-icon" src="/images/figma/icon-weight.png" mode="aspectFit" />
            <text>体重记录</text>
          </view>
        </view>
      </view>

      <view class="home-section prompt-section">
        <view class="home-section-title">可以这样问我哦~</view>
        <view
          wx:for="{{questions}}"
          wx:key="*this"
          class="prompt-item tap-feedback" id="ripple-prompt-{{index}}" data-rippleid="prompt-{{index}}" bindtouchstart="startTouchRipple"
          hover-class="tap-feedback-active" hover-start-time="0" hover-stay-time="180"
          data-question="{{item}}"
          bindtap="ask"
        >
          <view wx:if="{{ripple.id === 'prompt-' + index}}" class="touch-ripple" style="left:{{ripple.x}}px;top:{{ripple.y}}px;" />
          <text>{{item}}</text>
          <image class="prompt-arrow" src="/images/figma/prompt-arrow.png" mode="aspectFit" />
        </view>
      </view>
    </view>

    <view wx:else class="conversation">
      <view
        wx:for="{{messages}}"
        wx:key="id"
        id="{{item.id}}"
        class="message-row {{item.role}}"
      >
        <block wx:if="{{item.role === 'user'}}">
          <view class="user-bubble">
            <text selectable>{{item.text}}</text>
            <image
              wx:if="{{item.image}}"
              class="message-image"
              src="{{item.image}}"
              mode="aspectFill"
            />
          </view>
        </block>

        <block wx:else>
          <view class="assistant-card">
            <view class="message-copy">
              <block wx:if="{{item.isTyping}}"><text selectable class="reveal-stable">{{item.revealStable}}</text><text class="reveal-focus">{{item.revealFocus}}</text><text class="reveal-haze">{{item.revealHaze}}</text><text class="typing-caret">│</text></block><text wx:else selectable>{{item.displayText !== undefined ? item.displayText : item.text}}</text>
            </view>
            <view wx:if="{{item.sticker && !item.isTyping}}" class="sticker-wrap">
              <image class="sticker" src="{{item.sticker}}" mode="aspectFit" bindload="onStickerReady" />
            </view>
            <view class="ai-credit">
              {{item.source === 'local' ? '本地演示回复' : (item.source === 'fixed' ? 'AI搭子' : '云端AI生成')}}
            </view>
            <view wx:if="{{!item.isTyping}}" class="message-actions">
              <view
                class="message-action"
                data-text="{{item.text}}"
                bindtap="copyMessage"
                aria-label="复制回复"
              >
                <image class="message-action-image" src="/images/figma/message-copy-v2.png" mode="scaleToFill" />
              </view>
              <view class="message-action" bindtap="retryMessage" aria-label="重新回答">
                <image class="message-action-image" src="/images/figma/message-retry-v2.png" mode="scaleToFill" />
              </view>
              <view class="message-action" bindtap="showMessageMore" aria-label="更多操作">
                <image class="message-action-image" src="/images/figma/message-more-v2.png" mode="scaleToFill" />
              </view>
              <view class="message-action speaker-action" bindtap="readMessage" aria-label="朗读回复">
                <image class="message-action-image" src="/images/figma/message-speaker-v2.png" mode="scaleToFill" />
              </view>
            </view>
          </view>
        </block>
      </view>

      <!-- 视频参考：问题在上方，AI 未生成前显示灰色文字骨架，品牌色闪光跟随扫描 -->
      <view wx:if="{{loading}}" id="loading" class="thinking-block" aria-label="搭搭正在思考">
        <view class="thinking-shell">
          <view class="thinking-spark">✦</view>
          <view class="thinking-placeholder">
            <view class="thinking-line thinking-line-one"></view>
            <view class="thinking-line thinking-line-two"></view>
            <view class="thinking-line thinking-line-three"></view>
          </view>
          <view class="thinking-scan"></view>
        </view>
        <view class="thinking-status">
          <view class="thinking-status-dot"></view>
          <text>搭搭正在组织回复</text>
          <view class="thinking-ellipsis"><text>·</text><text>·</text><text>·</text></view>
        </view>
      </view>

    </view>

    <view id="chat-end" class="chat-end"></view>
    <view class="scroll-spacer"></view>
  </scroll-view>

  <view class="composer-wrap {{messages.length ? 'with-tabs' : ''}} {{chatKeyboardHeight > 0 ? 'keyboard-visible' : ''}}" style="transform: translate3d(0, -{{chatKeyboardHeight}}px, 0);">
    <view wx:if="{{messages.length}}" class="quick-tabs" aria-label="快捷功能">
      <view class="quick-row">
        <view id="ripple-card-5" data-rippleid="card-5" bindtouchstart="startTouchRipple" class="quick-chip tap-feedback" hover-class="quick-chip-pressed" hover-start-time="0" hover-stay-time="180" data-action="plan" bindtap="openQuick" aria-label="训练计划">
          <view wx:if="{{ripple.id === 'card-5'}}" class="touch-ripple" style="left:{{ripple.x}}px;top:{{ripple.y}}px;" />
          <image class="quick-chip-art" src="/images/figma/quick-training.png" mode="aspectFit" />
        </view>
        <view id="ripple-card-6" data-rippleid="card-6" bindtouchstart="startTouchRipple" class="quick-chip tap-feedback" hover-class="quick-chip-pressed" hover-start-time="0" hover-stay-time="180" data-action="exercise" bindtap="openQuick" aria-label="运动记录">
          <view wx:if="{{ripple.id === 'card-6'}}" class="touch-ripple" style="left:{{ripple.x}}px;top:{{ripple.y}}px;" />
          <image class="quick-chip-art" src="/images/figma/quick-exercise.png" mode="aspectFit" />
        </view>
        <view id="ripple-card-7" data-rippleid="card-7" bindtouchstart="startTouchRipple" class="quick-chip tap-feedback" hover-class="quick-chip-pressed" hover-start-time="0" hover-stay-time="180" data-action="diet" bindtap="openQuick" aria-label="饮食记录">
          <view wx:if="{{ripple.id === 'card-7'}}" class="touch-ripple" style="left:{{ripple.x}}px;top:{{ripple.y}}px;" />
          <image class="quick-chip-art" src="/images/figma/quick-diet.png" mode="aspectFit" />
        </view>
        <view id="ripple-card-8" data-rippleid="card-8" bindtouchstart="startTouchRipple" class="quick-chip tap-feedback" hover-class="quick-chip-pressed" hover-start-time="0" hover-stay-time="180" data-action="weight" bindtap="openQuick" aria-label="体重记录">
          <view wx:if="{{ripple.id === 'card-8'}}" class="touch-ripple" style="left:{{ripple.x}}px;top:{{ripple.y}}px;" />
          <image class="quick-chip-art" src="/images/figma/quick-weight.png" mode="aspectFit" />
        </view>
      </view>
    </view>

    <view class="composer-box">
      <view class="composer-field">
        <text wx:if="{{!input}}" class="composer-placeholder-text">询问AI搭子</text>
        <input
          class="composer-input"
          value="{{input}}"
          maxlength="500"
          adjust-position="{{false}}"
          cursor-spacing="{{0}}"
          bindkeyboardheightchange="onChatKeyboardHeightChange"
          bindblur="onChatInputBlur"
          confirm-type="send"
          bindinput="onInput"
          bindconfirm="onSend"
          placeholder=" "
          placeholder-style="color:transparent;"
        />
      </view>
      <view class="composer-actions">
        <view class="composer-plus" bindtap="openAttach" aria-label="添加">
          <image class="composer-action-icon" src="/images/figma/composer-add.png" mode="aspectFit" />
        </view>
        <view class="composer-mic" catchtouchstart="onVoiceHoldStart" catchtouchmove="onVoiceHoldMove" catchtouchend="onVoiceHoldEnd" catchtouchcancel="onVoiceHoldCancel" aria-label="按住语音输入">
          <image class="composer-action-icon composer-mic-icon" src="/images/figma/composer-mic-ref.png" mode="aspectFit" />
        </view>
      </view>
    </view>
  </view>

  <view wx:if="{{recordSheet}}" class="record-mask" catchtap="closeRecord">
    <view class="record-sheet" catchtap="noop" style="bottom: {{recordKeyboardHeight}}px;">
      <view class="record-header">
        <view class="record-title-wrap">
          <image class="record-type-icon" src="{{activeRecord.icon}}" mode="aspectFit" />
          <text class="record-title">{{activeRecord.title}}</text>
        </view>
        <view class="record-close" bindtap="closeRecord">×</view>
      </view>

      <view class="record-photo" bindtap="showPhotoMenu">
        <image wx:if="{{recordImage}}" class="record-preview" src="{{recordImage}}" mode="aspectFill" />
        <block wx:else>
          <image class="record-photo-icon" src="/images/figma/photo-camera.png" mode="aspectFit" />
          <text>{{activeRecord.photoHint}}</text>
        </block>
      </view>

      <view class="record-input-row">
        <view class="record-input-wrap" bindtap="hidePhotoMenu">
          <input
            class="record-input"
            value="{{recordInput}}"
            focus="{{recordFocus}}"
            hold-keyboard="true"
            confirm-hold="true"
            adjust-position="false"
            cursor-spacing="0"
            bindkeyboardheightchange="onRecordKeyboardHeightChange"
            bindinput="onRecordInput"
            bindfocus="hidePhotoMenu"
            bindconfirm="sendRecord"
            confirm-type="send"
            placeholder="{{activeRecord.placeholder}}"
            placeholder-class="record-placeholder"
            placeholder-style="color:#a39fa4;"
          />
        </view>
        <view class="record-add" bindtap="showPhotoMenu" aria-label="添加照片">
          <image class="record-add-icon" src="/images/figma/record-plus.png" mode="aspectFit" />
        </view>
        <view class="record-send" bindtap="sendRecord" aria-label="发送记录">
          <image class="record-send-icon" src="/images/figma/record-send.png" mode="aspectFit" />
        </view>
      </view>

      <view wx:if="{{photoMenu}}" class="photo-popover" catchtouchstart="noop" catchtap="noop">
        <view class="photo-menu-item" bindtap="chooseFromAlbum">
          <image class="photo-menu-icon" src="/images/figma/photo-album.png" mode="aspectFit" />
          <text>相册</text>
        </view>
        <view class="photo-menu-item" bindtap="takePhoto">
          <image class="photo-menu-icon" src="/images/figma/photo-camera.png" mode="aspectFit" />
          <text>拍照片</text>
        </view>
      </view>
    </view>
  </view>

  <!-- This layer exists only while the finger is held on the microphone. -->
  <view wx:if="{{voiceOpen}}" class="voice-mask {{voiceCancelArmed ? 'voice-cancel-armed' : ''}}"
    catchtouchstart="noop" catchtouchmove="onVoiceHoldMove"
    catchtouchend="onVoiceHoldEnd" catchtouchcancel="onVoiceHoldCancel">
    <view class="voice-diffusion" aria-hidden="true">
      <view class="voice-blob voice-blob-coral"></view>
      <view class="voice-blob voice-blob-peach"></view>
      <view class="voice-blob voice-blob-lavender"></view>
      <view class="voice-blob voice-blob-mint"></view>
    </view>
    <view class="voice-content">
      <view class="voice-title">{{voiceCancelArmed ? '松手取消录音' : 'AI搭子正在听，请说话'}}</view>
      <view class="voice-tip">
        <text>{{voiceCancelArmed ? '向下移回继续录音' : '松手结束'}}</text>
        <text wx:if="{{!voiceCancelArmed}}" class="voice-tip-gap">上滑取消</text>
      </view>
      <view class="voice-dots">
        <view wx:for="{{voiceDots}}" wx:key="id"
          class="voice-dot {{item.active ? 'is-active' : ''}} {{item.peak ? 'is-peak' : ''}}"
          style="animation-delay: {{item.id * -0.085}}s;"></view>
      </view>
    </view>
    <view class="voice-button">
      <image class="voice-ellipse" src="/images/figma/voice-hold-ellipse.webp" mode="scaleToFill" />
      <image class="voice-button-icon" src="/images/figma/voice-mic-active-ref.png" mode="aspectFit" />
    </view>
  </view>
</view>
