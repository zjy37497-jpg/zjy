/* 搭练主题色点击反馈：珊瑚粉高亮 + 柔光扩散 + 轻微按压。
   仅改变触摸反馈，不改变原有卡片点击业务逻辑。 */
.tap-feedback {
  position: relative;
  overflow: hidden;
  transition: transform 180ms ease, background-color 220ms ease, box-shadow 220ms ease;
}
.tap-feedback-active {
  transform: scale(0.965);
  background-color: #fff0f0;
  box-shadow: inset 0 0 0 2rpx rgba(255, 128, 128, 0.30), 0 5rpx 18rpx rgba(255, 128, 128, 0.13);
}
@keyframes coral-tap-ripple {
  0% { opacity: 0.85; transform: translate(-50%, -50%) scale(0); }
  100% { opacity: 0; transform: translate(-50%, -50%) scale(13); }
}

/* Ripple originates exactly where the finger touches, not from card center. */
.tap-feedback .touch-ripple {
  position: absolute;
  z-index: 2;
  width: 36rpx;
  height: 36rpx;
  margin-left: -18rpx;
  margin-top: -18rpx;
  border-radius: 50%;
  background: rgba(255, 128, 128, 0.27);
  pointer-events: none;
  animation: coral-touch-origin 450ms ease-out forwards;
}
@keyframes coral-touch-origin {
  0% { opacity: 0.9; transform: scale(0); }
  100% { opacity: 0; transform: scale(13); }
}

/* Reply reveal: branded caret travels with the last visible character. */
.typing-caret {
  display: inline;
  color: #ff8080;
  font-size: 29rpx;
  font-weight: 600;
  animation: dada-caret-pulse 0.75s step-end infinite;
}
@keyframes dada-caret-pulse {
  0%, 49% { opacity: 1; }
  50%, 100% { opacity: 0; }
}

/* Reference-inspired optical text reveal. The leading two glyphs come into
   focus slightly enlarged, followed by a soft coral-tinted defocused tail. */
.reveal-stable { color: inherit; }
.reveal-focus {
  color: #ff8080;
  font-size: 1.075em;
  font-weight: 600;
  letter-spacing: .15rpx;
  animation: dada-focus-in 190ms cubic-bezier(.18,.72,.26,1) both;
}
.reveal-haze {
  color: rgba(255, 128, 128, .43);
  font-size: 1.035em;
  opacity: .56;
  filter: blur(2.3rpx);
  animation: dada-haze-float 240ms ease-out both;
}
@keyframes dada-focus-in {
  0% { opacity: .40; filter: blur(1.7rpx); }
  100% { opacity: 1; filter: blur(0); }
}
@keyframes dada-haze-float {
  0% { opacity: .20; filter: blur(3.2rpx); }
  100% { opacity: .56; filter: blur(2.3rpx); }
}
.typing-caret { color: #ff8080; font-size: 24rpx; opacity: .72; }

/* Homepage entrance: keep original layout and proportions intact. */
.mascot-stage-before {
  opacity: 0;
  clip-path: inset(0 100% 0 0);
  transform: translate3d(-48rpx, 0, 0);
}
.mascot-stage-enter {
  animation: dalian-mascot-left-reveal 850ms cubic-bezier(.18,.74,.22,1) both;
}
@keyframes dalian-mascot-left-reveal {
  0% {
    opacity: 0;
    clip-path: inset(0 100% 0 0);
    transform: translate3d(-48rpx, 0, 0);
  }
  48% {
    opacity: 1;
  }
  100% {
    opacity: 1;
    clip-path: inset(0 0 0 0);
    transform: translate3d(0, 0, 0);
  }
}
/* The crisp slogan SVG preserves the original 330rpx x 112rpx placement. */
.hero-copy .hero-slogan {
  width: 330rpx;
  height: 112rpx;
}

/* Each glyph is a window onto the same sharp vector slogan: no font substitution,
   layout shifts, or changes to the original 330rpx × 112rpx area. */
.hero-slogan-animated {
  position: relative;
  display: block;
  width: 330rpx;
  height: 112rpx;
  overflow: hidden;
}
.hero-glyph {
  position: absolute;
  overflow: hidden;
  opacity: 0;
  transform: translate3d(-7rpx, 3rpx, 0) scale(.985);
  transform-origin: center center;
  animation: dalian-glyph-arrive 430ms cubic-bezier(.18,.8,.2,1) both;
}
.hero-glyph-image {
  position: absolute;
  width: 330rpx;
  height: 112rpx;
  max-width: none;
  pointer-events: none;
}
@keyframes dalian-glyph-arrive {
  0% {opacity:0; transform:translate3d(-7rpx,3rpx,0) scale(.985);filter:blur(2px);}
  58% {opacity:1; transform:translate3d(0,0,0) scale(1.02);filter:blur(.3px);}
  100% {opacity:1; transform:translate3d(0,0,0) scale(1);filter:blur(0);}
}

/* Keep every letter as an unchanged static SVG: no per-frame image replacements. */
.hero-glyph-image {
  backface-visibility: hidden;
}
.hero-slogan-animated {
  isolation: isolate;
}

/* The mascot body is a PNG layer, not the animated eyes or transparent background. */
.mascot-body{display:block;z-index:1;opacity:1;visibility:visible}
