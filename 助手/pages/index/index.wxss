/* AI 生成占位：灰色骨架 + 珊瑚粉主题色，不采用参考视频里的蓝色 */
.thinking-block { padding: 18rpx 0 28rpx; }
.thinking-shell {
  position: relative;
  display: flex;
  align-items: flex-start;
  box-sizing: border-box;
  width: 620rpx;
  min-height: 148rpx;
  padding: 28rpx 25rpx;
  border: 2rpx solid #f3e5e4;
  border-radius: 24rpx;
  background: #fbf9f9;
  overflow: hidden;
  animation: thinking-enter 420ms cubic-bezier(.2,.75,.25,1) both, thinking-float 2.8s ease-in-out 420ms infinite;
}
.thinking-spark {
  position: relative;
  z-index: 1;
  margin-right: 20rpx;
  color: #ff8080;
  font-size: 36rpx;
  line-height: 36rpx;
  animation: thinking-spark-pulse 1.8s ease-in-out infinite;
}
.thinking-placeholder { flex: 1; padding-top: 3rpx; }
.thinking-line {
  height: 16rpx;
  margin-bottom: 16rpx;
  border-radius: 9rpx;
  background: linear-gradient(90deg, #e6e3e5 0%, #eee9eb 35%, #ffe7e7 50%, #eee9eb 65%, #e6e3e5 100%);
  background-size: 240% 100%;
  animation: thinking-shimmer 1.75s ease-in-out infinite;
}
.thinking-line-one { width: 86%; }
.thinking-line-two { width: 96%; animation-delay: 120ms; }
.thinking-line-three { width: 58%; margin-bottom: 0; animation-delay: 240ms; }
.thinking-scan {
  position: absolute;
  top: 0;
  bottom: 0;
  width: 94rpx;
  left: -100rpx;
  opacity: .46;
  background: linear-gradient(90deg, transparent, rgba(255,128,128,.11), transparent);
  transform: skewX(-15deg);
  animation: thinking-sweep 2.45s ease-in-out infinite;
  pointer-events: none;
}
.thinking-status {
  display: flex;
  align-items: center;
  margin: 16rpx 0 0 15rpx;
  color: #9b9396;
  font-size: 23rpx;
}
.thinking-status-dot {
  width: 10rpx;
  height: 10rpx;
  margin-right: 12rpx;
  border-radius: 50%;
  background: #ff8080;
  animation: thinking-status-breathe 1.7s ease-in-out infinite;
}
.thinking-ellipsis { display: flex; margin-left: 4rpx; color: #ff8080; font-size: 29rpx; }
.thinking-ellipsis text { animation: thinking-status-breathe 1.1s ease-in-out infinite; }
.thinking-ellipsis text:nth-child(2) { animation-delay: 140ms; }
.thinking-ellipsis text:nth-child(3) { animation-delay: 280ms; }
@keyframes thinking-enter {
  from { opacity: 0; transform: translateY(13rpx) scale(.985); }
  to { opacity: 1; transform: translateY(0) scale(1); }
}
@keyframes thinking-float {
  0%,100% { transform: translateY(0); }
  50% { transform: translateY(-4rpx); }
}
@keyframes thinking-spark-pulse {
  0%,100% { opacity: .48; transform: scale(.88) rotate(-8deg); }
  48% { opacity: 1; transform: scale(1.10) rotate(6deg); }
}
@keyframes thinking-shimmer {
  0% { background-position: 110% 0; opacity: .7; }
  55% { opacity: 1; }
  100% { background-position: -110% 0; opacity: .77; }
}
@keyframes thinking-sweep {
  0%,15% { left: -100rpx; }
  75%,100% { left: 700rpx; }
}
@keyframes thinking-status-breathe {
  0%,100% { opacity: .3; transform: scale(.85); }
  50% { opacity: 1; transform: scale(1); }
}

/* ===== 吉祥物 wink 动画（循环 6.4s）：睁眼 → 眨眼 → 期待 → wink（“<”）+ 星星 ===== */

@keyframes mascot-star-float {
  0% { opacity: 0.9; transform: translate(0rpx, 0rpx) rotate(0deg) scale(1); }
  25% { opacity: 1; transform: translate(-2rpx, -4rpx) rotate(2deg) scale(1.03); }
  50% { opacity: 0.9; transform: translate(0rpx, 0rpx) rotate(0deg) scale(1); }
  62% { opacity: 0.9; transform: translate(0rpx, 0rpx) rotate(0deg) scale(1); }
  65% { opacity: 1; transform: translate(-2rpx, -5rpx) rotate(6deg) scale(1.12); }
  70% { opacity: 1; transform: translate(-2rpx, -3rpx) rotate(2deg) scale(1.04); }
  76% { opacity: 0.9; transform: translate(0rpx, 0rpx) rotate(0deg) scale(1); }
  87% { opacity: 1; transform: translate(-2rpx, -4rpx) rotate(2deg) scale(1.03); }
  100% { opacity: 0.9; transform: translate(0rpx, 0rpx) rotate(0deg) scale(1); }
}

@keyframes mascot-eyes-tilt {
  0% { transform: translateY(0rpx) rotate(0deg); }
  62% { transform: translateY(0rpx) rotate(0deg); }
  64.8% { transform: translateY(-2rpx) rotate(-2.2deg); }
  70% { transform: translateY(-1.5rpx) rotate(-1.5deg); }
  76% { transform: translateY(0rpx) rotate(0deg); }
  100% { transform: translateY(0rpx) rotate(0deg); }
}

@keyframes mascot-eye-left {
  0% { opacity: 1; transform: translateY(0rpx) rotate(8.1deg) scale(1, 1) rotate(-8.1deg); }
  46.8% { opacity: 1; transform: translateY(0rpx) rotate(8.1deg) scale(1, 1) rotate(-8.1deg); }
  47.7% { opacity: 1; transform: translateY(0rpx) rotate(8.1deg) scale(1.15, 0.18) rotate(-8.1deg); }
  48.8% { opacity: 1; transform: translateY(0rpx) rotate(8.1deg) scale(1, 1) rotate(-8.1deg); }
  56% { opacity: 1; transform: translateY(0rpx) rotate(8.1deg) scale(1, 1) rotate(-8.1deg); }
  58.2% { opacity: 1; transform: translateY(0rpx) rotate(8.1deg) scale(1.06, 1.06) rotate(-8.1deg); }
  60.6% { opacity: 1; transform: translateY(0rpx) rotate(8.1deg) scale(1, 1) rotate(-8.1deg); }
  62.4% { opacity: 1; transform: translateY(0rpx) rotate(8.1deg) scale(1, 1) rotate(-8.1deg); }
  64.6% { opacity: 1; transform: translateY(0rpx) rotate(8.1deg) scale(0.98, 1.07) rotate(-8.1deg); }
  67% { opacity: 1; transform: translateY(0rpx) rotate(8.1deg) scale(1, 1) rotate(-8.1deg); }
  100% { opacity: 1; transform: translateY(0rpx) rotate(8.1deg) scale(1, 1) rotate(-8.1deg); }
}

@keyframes mascot-eye-open {
  0% { opacity: 0; transform: translateY(0rpx) rotate(8.1deg) scale(1.2, 0.3) rotate(-8.1deg); }
  35.4% { opacity: 0; transform: translateY(0rpx) rotate(8.1deg) scale(1.2, 0.3) rotate(-8.1deg); }
  35.41% { opacity: 1; transform: translateY(0rpx) rotate(8.1deg) scale(1.2, 0.3) rotate(-8.1deg); }
  38.4% { opacity: 1; transform: translateY(0rpx) rotate(8.1deg) scale(0.95, 1.12) rotate(-8.1deg); }
  41% { opacity: 1; transform: translateY(0rpx) rotate(8.1deg) scale(1, 1) rotate(-8.1deg); }
  46.8% { opacity: 1; transform: translateY(0rpx) rotate(8.1deg) scale(1, 1) rotate(-8.1deg); }
  47.7% { opacity: 1; transform: translateY(0rpx) rotate(8.1deg) scale(1.15, 0.18) rotate(-8.1deg); }
  48.8% { opacity: 1; transform: translateY(0rpx) rotate(8.1deg) scale(1, 1) rotate(-8.1deg); }
  56% { opacity: 1; transform: translateY(0rpx) rotate(8.1deg) scale(1, 1) rotate(-8.1deg); }
  58.2% { opacity: 1; transform: translateY(0rpx) rotate(8.1deg) scale(1.06, 1.06) rotate(-8.1deg); }
  60.4% { opacity: 1; transform: translateY(0rpx) rotate(8.1deg) scale(1.2, 0.3) rotate(-8.1deg); }
  61.1% { opacity: 1; transform: translateY(0rpx) rotate(8.1deg) scale(1.2, 0.3) rotate(-8.1deg); }
  61.11% { opacity: 0; transform: translateY(0rpx) rotate(8.1deg) scale(1.2, 0.3) rotate(-8.1deg); }
  100% { opacity: 0; transform: translateY(0rpx) rotate(8.1deg) scale(1.2, 0.3) rotate(-8.1deg); }
}

@keyframes mascot-eye-chevron {
  0% { opacity: 1; transform: translateY(0rpx) rotate(0deg) scale(1, 1) rotate(0deg); }
  33% { opacity: 1; transform: translateY(0rpx) rotate(0deg) scale(1, 1) rotate(0deg); }
