@keyframes flow-pink {
  0% { transform: translate(0rpx, 0rpx) rotate(0deg) scale(1); }
  35% { transform: translate(130rpx, 50rpx) rotate(16deg) scale(1.14); }
  70% { transform: translate(50rpx, 150rpx) rotate(-12deg) scale(0.94); }
  100% { transform: translate(0rpx, 0rpx) rotate(0deg) scale(1); }
}

@keyframes flow-peach {
  0% { transform: translate(0rpx, 0rpx) rotate(0deg) scale(1); }
  30% { transform: translate(-150rpx, 70rpx) rotate(-14deg) scale(1.12); }
  65% { transform: translate(-60rpx, 160rpx) rotate(10deg) scale(0.92); }
  100% { transform: translate(0rpx, 0rpx) rotate(0deg) scale(1); }
}

@keyframes flow-lilac {
