@keyframes flow-rose {
  0% { transform: translate(0rpx, 0rpx) rotate(0deg) scale(1); }
  35% { transform: translate(170rpx, -40rpx) rotate(12deg) scale(1.12); }
  70% { transform: translate(90rpx, -120rpx) rotate(-16deg) scale(0.92); }
