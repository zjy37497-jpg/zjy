@keyframes flow-mint {
  0% { transform: translate(0rpx, 0rpx) rotate(0deg) scale(1); }
  30% { transform: translate(-170rpx, -20rpx) rotate(-20deg) scale(1.15); }
  60% { transform: translate(-90rpx, -70rpx) rotate(14deg) scale(0.92); }
  100% { transform: translate(0rpx, 0rpx) rotate(0deg) scale(1); }
