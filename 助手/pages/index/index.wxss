  35.42% { opacity: 0; transform: translateY(-13.8rpx) rotate(0deg) scale(0.5, 0.16) rotate(0deg); }
  60.2% { opacity: 0; transform: translateY(-13.8rpx) rotate(0deg) scale(0.4, 0.14) rotate(0deg); }
  60.21% { opacity: 1; transform: translateY(-13.8rpx) rotate(0deg) scale(0.4, 0.14) rotate(0deg); }
