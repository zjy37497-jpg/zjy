<view class="profile-page">
  <view class="title">你的个人档案</view>
  <view class="note">只保存你确认过的资料，用于后续建议。健康情况是本人自述，不是诊断。拒绝保存不影响当前对话。</view>
  <view wx:if="{{error}}" class="error">{{error}}</view>
  <button wx:if="{{!ready}}" bindtap="refresh" loading="{{loading}}" disabled="{{loading}}">重新连接</button>
  <block wx:if="{{ready}}">
    <view class="state">长期记忆：{{enabled ? '已开启，每次写入仍需确认' : '已关闭，不读取档案生成建议'}}</view>
    <button bindtap="toggleMemory" disabled="{{loading}}">{{enabled ? '关闭记忆' : '开启记忆'}}</button>
    <view class="note">新增资料：回到聊天，明确告诉搭搭要记住什么。关闭不会删除旧资料；需要删除请使用下方按钮。</view>
    <view wx:if="{{!records.length}}" class="empty">尚无已保存资料</view>
    <view wx:for="{{records}}" wx:key="id" class="record">
      <view class="category">{{item.categoryName}}</view>
      <view class="statement">{{item.statement}}</view>
      <view class="meta">{{item.statusName}} · 更新于 {{item.updatedAt}}</view>
      <view class="actions">
        <button size="mini" data-id="{{item.id}}" bindtap="editRecord" disabled="{{loading || !enabled}}">更正</button>
        <button size="mini" data-id="{{item.id}}" bindtap="removeRecord" disabled="{{loading}}">删除</button>
      </view>
    </view>
    <button class="danger" bindtap="clearAll" disabled="{{loading}}">清空云端档案并关闭记忆</button>
    <view class="note">只管理云端个人档案，不清除当前聊天和本地计划。云端备份按服务的保留策略清理。</view>
  </block>
</view>
