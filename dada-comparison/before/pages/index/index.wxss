.page {
  display: flex;
  flex-direction: column;
  height: 100vh;
  background: linear-gradient(180deg, #e3f9ee 0%, #f1fcf7 38%, #fafffd 100%);
}
.chat { flex: 1; min-height: 0; }

.header { padding: 36rpx 36rpx 8rpx; }
.brand-row { display: flex; align-items: center; }
.brand { font-size: 32rpx; font-weight: 700; }
.chip {
  margin-left: 14rpx;
  padding: 4rpx 14rpx;
  font-size: 22rpx;
  color: #1f8a5b;
  background: #e0f5ea;
  border: 1rpx solid #bfe8d1;
  border-radius: 8rpx;
}
.headline { margin-top: 24rpx; font-size: 52rpx; font-weight: 700; line-height: 1.3; }
.subline { margin-top: 10rpx; font-size: 24rpx; color: #7b8a82; }
.tools { margin-top: 14rpx; font-size: 24rpx; color: #16a36d; }
.link { padding: 6rpx 0; }
.sep { margin: 0 14rpx; color: #b4c2ba; }

.list { padding: 24rpx 32rpx 32rpx; }
.row { display: flex; margin-bottom: 24rpx; }
.row.user { justify-content: flex-end; }
.bubble {
  max-width: 92%;
  padding: 24rpx 28rpx;
  border-radius: 24rpx;
  font-size: 28rpx;
  line-height: 1.7;
}
.bubble.assistant {
  background: #ffffff;
  color: #1c2b24;
  box-shadow: 0 2rpx 14rpx rgba(20, 80, 50, 0.06);
}
.bubble.user {
  max-width: 78%;
  background: #d9f2e5;
  border: 1rpx solid #c3e8d3;
  color: #14382a;
}
.msg { white-space: pre-wrap; word-break: break-all; }
.dim { color: #98a59e; }

.card {
  display: flex;
  align-items: center;
  margin-top: 22rpx;
  padding: 20rpx;
  background: #f1f7f4;
  border-radius: 20rpx;
}
.card-icon {
  flex: none;
  width: 80rpx;
  height: 80rpx;
  line-height: 80rpx;
  text-align: center;
  font-size: 40rpx;
  color: #ffffff;
  background: #1b9a6a;
  border-radius: 18rpx;
}
.card-body { margin-left: 20rpx; }
.card-title { font-size: 30rpx; font-weight: 700; }
.card-sub { margin-top: 4rpx; font-size: 24rpx; color: #6f8077; }

.clear { margin: 36rpx 0 8rpx; text-align: center; font-size: 24rpx; color: #98a59e; }
.end { height: 2rpx; }

.composer {
  display: flex;
  align-items: center;
  gap: 16rpx;
  padding: 16rpx 24rpx calc(16rpx + env(safe-area-inset-bottom));
  background: #ffffff;
  border-top: 1rpx solid #e8efeb;
}
.input {
  flex: 1;
  height: 80rpx;
  padding: 0 24rpx;
  font-size: 26rpx;
  background: #f1f3f2;
  border-radius: 20rpx;
}
.ph { color: #a0aaa5; }
.send {
  flex: 1;
  height: 72rpx;
  line-height: 72rpx;
  text-align: center;
  font-size: 28rpx;
  font-weight: 600;
  color: #ffffff;
  background: #16a36d;
  border-radius: 999rpx;
}
.send.off { opacity: 0.5; }

.trace{display:block;font-size:22rpx;color:#7c8983;margin-top:16rpx;line-height:1.5;}
